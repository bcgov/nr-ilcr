SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
LOG_LEVEL=INFO
ILCR_SECURITY_ENABLED=false

# Local Oracle dev DB. Keep real local credentials in ignored .env only.
# Leave ILCR_DATASOURCE_ENABLED=false for the in-memory scaffold.
# In Docker Compose, set ILCR_DATASOURCE_ENABLED=true to enable Oracle connectivity.
# For direct Maven runs, the oracle profile also enables the datasource.
ILCR_DATASOURCE_ENABLED=false
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@//<host>:1521/<service-name>
SPRING_DATASOURCE_USERNAME=<username>
SPRING_DATASOURCE_PASSWORD=<password>

# NR User Lookup API (DL-27) — the ministry directory behind the assignment picker.
# OFF everywhere until the service account is provisioned. The backend refuses to start with the
# flag on and any of the four values blank, so turn it on only once all of them are set.
# The client id/secret are a per-environment VAULT secret: put real values in ignored .env only,
# never here and never in application.yml.
ILCR_USER_LOOKUP_ENABLED=false
ILCR_USER_LOOKUP_BASE_URL=
ILCR_USER_LOOKUP_TOKEN_URL=
ILCR_USER_LOOKUP_CLIENT_ID=
ILCR_USER_LOOKUP_CLIENT_SECRET=
