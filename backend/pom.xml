        <connection>scm:git:https://github.com/bcgov/nr-ilcr.git</connection>
        <developerConnection>scm:git:ssh://git@github.com:bcgov/nr-ilcr.git</developerConnection>
        <url>https://github.com/bcgov/nr-ilcr</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <java.version>21</java.version>
        <jdk.version>21</jdk.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <skip.integration.tests>true</skip.integration.tests>
        <skip.unit.tests>false</skip.unit.tests>
        <jacoco.skip>false</jacoco.skip>
        <checkstyle.skip>false</checkstyle.skip>
        <checkstyle.failsOnError>true</checkstyle.failsOnError>
        <checkstyle.includeTestSourceDirectory>false</checkstyle.includeTestSourceDirectory>
        <cyclonedx.skip>false</cyclonedx.skip>
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <jasperreports.version>7.0.8</jasperreports.version>
        <sonar.organization>bcgov-sonarcloud</sonar.organization>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.java.checkstyle.reportPaths>target/checkstyle-result.xml</sonar.java.checkstyle.reportPaths>
        <!-- Keep Sonar coverage measurement in step with the jacoco instrumentation excludes
             below: config/dto/exception/boilerplate are not instrumented, so counting them as
             uncovered would understate new-code coverage for lines jacoco never reports on. -->
        <sonar.coverage.exclusions>**/configuration/**,**/dto/**,**/exception/**,**/*Application.*,**/*Constants.*</sonar.coverage.exclusions>
        <oci.revision>${project.version}</oci.revision>
    </properties>

    <profiles>
        <profile>
            <id>all-tests</id>
            <properties>
                <skip.integration.tests>false</skip.integration.tests>
                <skip.unit.tests>false</skip.unit.tests>
                <checkstyle.skip>false</checkstyle.skip>
            </properties>
        </profile>
        <profile>
            <!-- Local dev only (mvn spring-boot:run -Pdev). Adds DevTools live-reload/restart and
                 activates the Spring `dev` profile so the `dev` on-profile document in application.yml
                 (its DevToolsDataSourceAutoConfiguration exclude) applies. Neither ships to prod. -->
            <id>dev</id>
            <properties>
                <spring-boot.run.profiles>dev</spring-boot.run.profiles>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-devtools</artifactId>
                    <scope>runtime</scope>
                    <optional>true</optional>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>integration-test</id>
            <properties>
                <skip.integration.tests>false</skip.integration.tests>
                <skip.unit.tests>true</skip.unit.tests>
            </properties>
        </profile>
        <profile>
            <id>prod</id>
            <properties>
                <skip.unit.tests>true</skip.unit.tests>
            </properties>
        </profile>
    </profiles>

