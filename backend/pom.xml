            <name>Paulo Cruz</name>
            <email>paulo.cruz@gov.bc.ca</email>
            <url>https://paulushcgcj.github.io</url>
            <organization>BCGOV</organization>
            <organizationUrl>https://www2.gov.bc.ca/gov/content/home</organizationUrl>
            <roles>
