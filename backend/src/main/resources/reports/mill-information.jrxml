<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mill Information report — JasperReports 7 template (AD-16), ported from the legacy
  src/jasper-reports/MillInformation.jrxml with its portrait A4 geometry and section order preserved
  (FR9 column/section parity; redesign latitude rides DL-20).

  Filled from a bean datasource: one row per mill, so the detail band IS the per-mill section and a
  17-mill year renders 17 of them. All values arrive PRE-FORMATTED as Strings with "-" already
  substituted for absent data, matching how legacy built its JRMapCollectionDataSource — the template
  binds String fields and formats nothing itself.

  The legacy Submitter/Licensee's Delegate and Associated Auditor(s) tables are deliberately absent.
  Nothing in the system can turn a stored USER_GUID into a person's name: ILCR_USER holds no name, and
  the directory offers GUID lookup for BCeID only, so those tables could only have printed raw GUIDs.
  They return once name resolution exists.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    name="mill-information" pageWidth="595" pageHeight="842"
    whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20"
    topMargin="30" bottomMargin="30">
  <style name="bold" bold="true"/>
  <parameter name="year" class="java.lang.Integer"/>
  <parameter name="p_do_print_body" class="java.lang.Boolean"/>
  <!-- The per-mill PDF outline title. Legacy emitted one bookmark per mill via batch-mode export
       (SchedulesPrinter sets setCreatingBatchModeBookmarks(true)); an in-template anchor reproduces
       that and, unlike batch mode, still emits for a year that holds a single mill. -->
  <parameter name="bookmarkTitle" class="java.lang.String"/>
  <field name="mill" class="java.lang.String"/>
  <field name="millAddress1" class="java.lang.String"/>
  <field name="millAddress2" class="java.lang.String"/>
  <field name="millCity" class="java.lang.String"/>
  <field name="millPostalCode" class="java.lang.String"/>
  <field name="millRegion" class="java.lang.String"/>
  <field name="millActive" class="java.lang.String"/>
  <field name="openDate" class="java.lang.String"/>
  <field name="draftStatusDate" class="java.lang.String"/>
  <field name="submittedStatusDate" class="java.lang.String"/>
  <field name="verifiedStatusDate" class="java.lang.String"/>
  <field name="ownerClientName" class="java.lang.String"/>
  <field name="contactIndicator" class="java.lang.String"/>
  <field name="headOfficeName" class="java.lang.String"/>
  <field name="headOfficePhone" class="java.lang.String"/>
  <field name="divisionName" class="java.lang.String"/>
  <field name="divisionPhone" class="java.lang.String"/>
  <title height="31">
      <!-- Zero-height-looking white text field carrying the outline anchor, as the schedule
           templates do; suppressed when no title is passed. -->
      <element kind="textField" x="0" y="0" width="300" height="15" forecolor="#FFFFFF" mode="Transparent"
          bookmarkLevel="1" blankWhenNull="true">
        <printWhenExpression><![CDATA[$P{bookmarkTitle} != null]]></printWhenExpression>
        <expression><![CDATA[$P{bookmarkTitle}]]></expression>
        <anchorNameExpression><![CDATA[$P{bookmarkTitle}]]></anchorNameExpression>
      </element>
      <element kind="staticText" style="bold" x="0" y="0" width="555" height="15" hTextAlign="Center">
        <text><![CDATA[Government of British Columbia]]></text>
      </element>
      <element kind="textField" x="0" y="15" width="555" height="15" hTextAlign="Center">
        <expression><![CDATA[$P{year} + " Annual Interior Logging Cost Report"]]></expression>
      </element>
  </title>
  <pageHeader height="30">
      <element kind="staticText" style="bold" x="0" y="0" width="300" height="15">
        <text><![CDATA[Mill Information]]></text>
      </element>
      <element kind="staticText" x="353" y="0" width="202" height="15" hTextAlign="Right">
        <text><![CDATA[Timber Pricing Branch]]></text>
      </element>
      <element kind="textField" x="353" y="15" width="202" height="15" hTextAlign="Right" pattern="MMMMM dd, yyyy HH:mm:ss">
        <expression><![CDATA[new java.util.Date()]]></expression>
      </element>
  </pageHeader>
  <detail>
    <band height="265">
      <element kind="textField" style="bold" x="0" y="0" width="555" height="15" blankWhenNull="true">
        <expression><![CDATA[$F{mill}]]></expression>
      </element>

      <element kind="staticText" x="0" y="22" width="90" height="15">
        <text><![CDATA[Address:]]></text>
      </element>
      <element kind="textField" x="95" y="22" width="250" height="15" blankWhenNull="true">
        <expression><![CDATA[$F{millAddress1}]]></expression>
      </element>
      <element kind="textField" x="95" y="37" width="250" height="15" blankWhenNull="true">
        <expression><![CDATA[$F{millAddress2}]]></expression>
      </element>
      <element kind="staticText" x="0" y="52" width="90" height="15">
        <text><![CDATA[City:]]></text>
      </element>
      <element kind="textField" x="95" y="52" width="250" height="15" blankWhenNull="true">
        <expression><![CDATA[$F{millCity}]]></expression>
      </element>
      <element kind="staticText" x="0" y="67" width="90" height="15">
        <text><![CDATA[Postal Code:]]></text>
      </element>
      <element kind="textField" x="95" y="67" width="250" height="15" blankWhenNull="true">
        <expression><![CDATA[$F{millPostalCode}]]></expression>
      </element>
      <element kind="staticText" x="0" y="82" width="90" height="15">
        <text><![CDATA[Region:]]></text>
      </element>
      <element kind="textField" x="95" y="82" width="250" height="15" blankWhenNull="true">
        <expression><![CDATA[$F{millRegion}]]></expression>
      </element>
      <element kind="staticText" x="0" y="97" width="90" height="15">
        <text><![CDATA[Active:]]></text>
      </element>
      <element kind="textField" x="95" y="97" width="250" height="15" blankWhenNull="true">
        <expression><![CDATA[$F{millActive}]]></expression>
      </element>

      <element kind="staticText" style="bold" x="0" y="119" width="200" height="15">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <text><![CDATA[Schedule Status]]></text>
      </element>
      <element kind="staticText" x="0" y="136" width="90" height="15">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <text><![CDATA[Open:]]></text>
      </element>
      <element kind="textField" x="95" y="136" width="160" height="15" blankWhenNull="true">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <expression><![CDATA[$F{openDate}]]></expression>
      </element>
      <element kind="staticText" x="280" y="136" width="90" height="15">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <text><![CDATA[Draft:]]></text>
      </element>
      <element kind="textField" x="375" y="136" width="160" height="15" blankWhenNull="true">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <expression><![CDATA[$F{draftStatusDate}]]></expression>
      </element>
      <element kind="staticText" x="0" y="151" width="90" height="15">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <text><![CDATA[Submitted:]]></text>
      </element>
      <element kind="textField" x="95" y="151" width="160" height="15" blankWhenNull="true">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <expression><![CDATA[$F{submittedStatusDate}]]></expression>
      </element>
      <element kind="staticText" x="280" y="151" width="90" height="15">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <text><![CDATA[Verified:]]></text>
      </element>
      <element kind="textField" x="375" y="151" width="160" height="15" blankWhenNull="true">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <expression><![CDATA[$F{verifiedStatusDate}]]></expression>
      </element>

      <element kind="staticText" style="bold" x="0" y="173" width="200" height="15">
        <text><![CDATA[Ownership Information]]></text>
      </element>
      <element kind="staticText" x="0" y="190" width="90" height="15">
        <text><![CDATA[Name:]]></text>
      </element>
      <element kind="textField" x="95" y="190" width="440" height="15" blankWhenNull="true">
        <expression><![CDATA[$F{ownerClientName}]]></expression>
      </element>

      <element kind="staticText" style="bold" x="0" y="212" width="200" height="15">
        <text><![CDATA[Contacts]]></text>
      </element>
      <element kind="staticText" style="bold" x="0" y="229" width="90" height="15">
        <text><![CDATA[Head Office]]></text>
      </element>
      <element kind="textField" x="95" y="229" width="200" height="15" blankWhenNull="true">
        <expression><![CDATA[$F{headOfficeName}]]></expression>
      </element>
      <element kind="textField" x="300" y="229" width="120" height="15" blankWhenNull="true">
        <expression><![CDATA[$F{headOfficePhone}]]></expression>
      </element>
      <!-- The head-office contact indicator sits beside the head-office row in legacy; it is a Y/N
           flag, not a name, so it is labelled rather than left as a bare character. -->
      <element kind="staticText" x="425" y="229" width="70" height="15" hTextAlign="Right">
        <text><![CDATA[Indicator:]]></text>
      </element>
      <element kind="textField" x="500" y="229" width="35" height="15" blankWhenNull="true">
        <expression><![CDATA[$F{contactIndicator}]]></expression>
      </element>
      <element kind="staticText" style="bold" x="0" y="244" width="90" height="15">
        <text><![CDATA[Division]]></text>
      </element>
      <element kind="textField" x="95" y="244" width="200" height="15" blankWhenNull="true">
        <expression><![CDATA[$F{divisionName}]]></expression>
      </element>
      <element kind="textField" x="300" y="244" width="120" height="15" blankWhenNull="true">
        <expression><![CDATA[$F{divisionPhone}]]></expression>
      </element>
    </band>
  </detail>
  <pageFooter height="15">
      <element kind="staticText" x="400" y="0" width="40" height="15" hTextAlign="Right">
        <text><![CDATA[Page:]]></text>
      </element>
      <element kind="textField" x="445" y="0" width="60" height="15" hTextAlign="Right" evaluationTime="Now">
        <expression><![CDATA[$V{PAGE_NUMBER}]]></expression>
      </element>
      <element kind="staticText" x="507" y="0" width="15" height="15" hTextAlign="Center">
        <text><![CDATA[of]]></text>
      </element>
      <element kind="textField" x="524" y="0" width="31" height="15" evaluationTime="Report">
        <expression><![CDATA[$V{PAGE_NUMBER}]]></expression>
      </element>
  </pageFooter>
</jasperReport>
