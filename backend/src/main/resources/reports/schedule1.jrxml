<?xml version="1.0" encoding="UTF-8"?>
<!--
  Schedule 1 (Average Cost of Logging) — JasperReports 7 template (AD-16, Epic 20.5). JR7 Jackson/JAXB
  model. Bean-datasource fill from Schedule1Service's DTO (the 20.2 data-feed decision): Schedule 1 is
  a FLAT single-page statement, so the datasource carries ONE row with every fixed cell pre-formatted
  as a String (Schedule1SectionMapper; "-" for null). The one dynamic block is the "Other Cost List"
  at the bottom — an in-band nested list bound to the OtherCostList sub-dataset, fed from the single
  row's `otherCostRows` collection field.

  LANDSCAPE (842x595) like the rebuilt sibling sections so the long cross-schedule labels do not clip.
  Cross-schedule figures (143 Forest Mgmt Admin, 139 Less Silv Admin, 144 Subtotal, totals, Crown
  Timber Volume) are already derived by Schedule1Service — rendered verbatim. p_do_print_body gates
  the statement; p_do_print_comment gates the Comments block.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    name="schedule1" pageWidth="842" pageHeight="595" orientation="Landscape"
    whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20"
    topMargin="30" bottomMargin="30">
  <style name="bold" bold="true"/>
  <dataset name="OtherCostList">
    <field name="otherCostDesc" class="java.lang.String"/>
    <field name="otherCostVol" class="java.lang.String"/>
    <field name="otherCostCos" class="java.lang.String"/>
    <field name="otherCostCal" class="java.lang.String"/>
  </dataset>
  <parameter name="millTitleBlock" class="java.lang.String"/>
  <parameter name="year" class="java.lang.Integer"/>
  <parameter name="p_do_print_body" class="java.lang.Boolean"/>
  <parameter name="p_do_print_comment" class="java.lang.Boolean"/>
  <parameter name="bookmarkTitle" class="java.lang.String"/>
  <field name="crownTimberVolume" class="java.lang.String"/>
  <field name="standingTreeToTruckVol" class="java.lang.String"/>
  <field name="standingTreeToTruckCos" class="java.lang.String"/>
  <field name="standingTreeToTruckCal" class="java.lang.String"/>
  <field name="logTransportationVol" class="java.lang.String"/>
  <field name="logTransportationCos" class="java.lang.String"/>
  <field name="logTransportationCal" class="java.lang.String"/>
  <field name="roadManagementVol" class="java.lang.String"/>
  <field name="roadManagementCos" class="java.lang.String"/>
  <field name="roadManagementCal" class="java.lang.String"/>
  <field name="roadConstructionCostVol" class="java.lang.String"/>
  <field name="roadConstructionCostCos" class="java.lang.String"/>
  <field name="roadConstructionCostCal" class="java.lang.String"/>
  <field name="postLoggingTreatmentVol" class="java.lang.String"/>
  <field name="postLoggingTreatmentCos" class="java.lang.String"/>
  <field name="postLoggingTreatmentCal" class="java.lang.String"/>
  <field name="forestManagementVol" class="java.lang.String"/>
  <field name="forestManagementCos" class="java.lang.String"/>
  <field name="forestManagementCal" class="java.lang.String"/>
  <field name="stumpageRoyaltyVol" class="java.lang.String"/>
  <field name="stumpageRoyaltyCos" class="java.lang.String"/>
  <field name="stumpageRoyaltyCal" class="java.lang.String"/>
  <field name="depletionAmortizationVol" class="java.lang.String"/>
  <field name="depletionAmortizationCos" class="java.lang.String"/>
  <field name="depletionAmortizationCal" class="java.lang.String"/>
  <field name="subtotalOtherCostsVol" class="java.lang.String"/>
  <field name="subtotalOtherCostsCos" class="java.lang.String"/>
  <field name="subtotalOtherCostsCal" class="java.lang.String"/>
  <field name="subtotalCompanyCostsVol" class="java.lang.String"/>
  <field name="subtotalCompanyCostsCos" class="java.lang.String"/>
  <field name="subtotalCompanyCostsCal" class="java.lang.String"/>
  <field name="silvActualSpentVol" class="java.lang.String"/>
  <field name="silvActualSpentCos" class="java.lang.String"/>
  <field name="silvActualSpentCal" class="java.lang.String"/>
  <field name="silvAdminCostVol" class="java.lang.String"/>
  <field name="silvAdminCostCos" class="java.lang.String"/>
  <field name="silvAdminCostCal" class="java.lang.String"/>
  <field name="silvAccruedSpentVol" class="java.lang.String"/>
  <field name="silvAccruedSpentCos" class="java.lang.String"/>
  <field name="silvAccruedSpentCal" class="java.lang.String"/>
  <field name="silvTotalVolumeVol" class="java.lang.String"/>
  <field name="silvTotalVolumeCos" class="java.lang.String"/>
  <field name="silvTotalVolumeCal" class="java.lang.String"/>
  <field name="totalVol" class="java.lang.String"/>
  <field name="totalCos" class="java.lang.String"/>
  <field name="totalCal" class="java.lang.String"/>
  <field name="comments" class="java.lang.String"/>
  <field name="otherCostRows" class="java.util.Collection"/>
  <title height="30">
    <element kind="textField" x="0" y="0" width="300" height="15" forecolor="#FFFFFF" mode="Transparent"
        bookmarkLevel="1" blankWhenNull="true">
      <printWhenExpression><![CDATA[$P{bookmarkTitle} != null]]></printWhenExpression>
      <expression><![CDATA[$P{bookmarkTitle}]]></expression>
      <anchorNameExpression><![CDATA[$P{bookmarkTitle}]]></anchorNameExpression>
    </element>
    <element kind="staticText" style="bold" x="0" y="0" width="802" height="15" hTextAlign="Center">
      <text><![CDATA[Government of British Columbia]]></text>
    </element>
    <element kind="textField" x="0" y="15" width="802" height="15" hTextAlign="Center">
      <expression><![CDATA[$P{year} + " Annual Interior Logging Cost Report"]]></expression>
    </element>
  </title>
  <pageHeader height="34">
    <element kind="staticText" style="bold" x="0" y="0" width="802" height="15">
      <text><![CDATA[Schedule 1:  Average Cost of Logging]]></text>
    </element>
    <element kind="textField" x="0" y="16" width="802" height="15" hTextAlign="Left" blankWhenNull="true">
      <expression><![CDATA[$P{millTitleBlock}]]></expression>
    </element>
  </pageHeader>
  <detail>
    <band height="420">
      <!-- Column headers (body-gated). Label column 430 wide; three right-aligned value columns. -->
      <element kind="staticText" style="bold" x="435" y="0" width="115" height="15" hTextAlign="Right">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <text><![CDATA[Volume m³]]></text>
      </element>
      <element kind="staticText" style="bold" x="555" y="0" width="115" height="15" hTextAlign="Right">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <text><![CDATA[Cost $]]></text>
      </element>
      <element kind="staticText" style="bold" x="675" y="0" width="127" height="15" hTextAlign="Right">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <text><![CDATA[$/m³]]></text>
      </element>

      <!-- Crown Timber Volume (single Volume cell; cross-schedule). Always prints (identity line). -->
      <element kind="staticText" x="0" y="20" width="430" height="16" hTextAlign="Left">
        <text><![CDATA[Crown Timber Volume for all fields (Sch 3): ]]></text>
      </element>
      <element kind="textField" x="435" y="20" width="115" height="16" hTextAlign="Right" blankWhenNull="true">
