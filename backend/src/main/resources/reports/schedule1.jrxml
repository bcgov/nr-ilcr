      </element>
      <element kind="component" x="0" y="338" width="802" height="16">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <component kind="list" printOrder="Vertical">
          <datasetRun subDataset="OtherCostList">
            <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRMapCollectionDataSource($F{otherCostRows})]]></dataSourceExpression>
          </datasetRun>
          <contents height="16">
            <element kind="textField" x="0" y="0" width="430" height="16" blankWhenNull="true">
              <expression><![CDATA[$F{otherCostDesc}]]></expression>
