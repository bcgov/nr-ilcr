      <element kind="textField" x="320" y="104" width="100" height="16" hTextAlign="Right"><printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression><expression><![CDATA[$F{dewaterAndReloadCost}]]></expression></element>
      <element kind="textField" x="435" y="104" width="100" height="16" hTextAlign="Right"><printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression><expression><![CDATA[$F{dewaterAndReloadCostVol}]]></expression></element>
      <element kind="staticText" x="0" y="120" width="200" height="16"><printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression><text><![CDATA[Hydro Dam Log Transfer:]]></text></element>
      <element kind="textField" x="205" y="120" width="100" height="16" hTextAlign="Right"><printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression><expression><![CDATA[$F{hydroDamLogTransferVol}]]></expression></element>
      <element kind="textField" x="320" y="120" width="100" height="16" hTextAlign="Right"><printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression><expression><![CDATA[$F{hydroDamLogTransferCost}]]></expression></element>
      <element kind="textField" x="435" y="120" width="100" height="16" hTextAlign="Right"><printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression><expression><![CDATA[$F{hydroDamLogTransferCostVol}]]></expression></element>
