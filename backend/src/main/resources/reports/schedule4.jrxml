      <element kind="component" positionType="Float" x="0" y="276" width="555" height="16"><printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression><component kind="list" printOrder="Vertical"><datasetRun subDataset="TowingRows"><dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRMapCollectionDataSource($F{towingRows})]]></dataSourceExpression></datasetRun><contents height="16" width="555"><element kind="textField" style="italic" x="0" y="0" width="200" height="16"><expression><![CDATA[$F{towingTotalDescription}]]></expression></element><element kind="textField" x="205" y="0" width="80" height="16" hTextAlign="Right"><expression><![CDATA[$F{towingTotalDist}]]></expression></element><element kind="textField" x="290" y="0" width="80" height="16" hTextAlign="Right"><expression><![CDATA[$F{towingTotalVolume}]]></expression></element><element kind="textField" x="375" y="0" width="80" height="16" hTextAlign="Right"><expression><![CDATA[$F{towingTotalCost}]]></expression></element><element kind="textField" x="460" y="0" width="80" height="16" hTextAlign="Right"><expression><![CDATA[$F{towingTotalCostVolume}]]></expression></element></contents></component></element>
