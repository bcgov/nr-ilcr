      <element kind="textField" x="605" y="107" width="140" height="15" blankWhenNull="true">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <expression><![CDATA[$F{equipRail}]]></expression>
      </element>
      <element kind="staticText" x="400" y="122" width="200" height="15">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <text><![CDATA[Equipment and Supplies (Air):]]></text>
      </element>
      <element kind="textField" x="605" y="122" width="140" height="15" blankWhenNull="true">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <expression><![CDATA[$F{equipAir}]]></expression>
