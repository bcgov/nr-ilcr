      <element kind="staticText" x="400" y="137" width="200" height="15">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <text><![CDATA[Equipment and Supplies (Water):]]></text>
      </element>
      <element kind="textField" x="605" y="137" width="140" height="15" blankWhenNull="true">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <expression><![CDATA[$F{equipWater}]]></expression>
      </element>
      <element kind="staticText" x="400" y="152" width="200" height="15">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <text><![CDATA[Other Access Expenses:]]></text>
      </element>
      <element kind="textField" x="605" y="152" width="140" height="15" blankWhenNull="true">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <expression><![CDATA[$F{otherAccessExpenses}]]></expression>
      </element>
      <element kind="staticText" style="bold" x="400" y="167" width="200" height="15">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <text><![CDATA[Access Expense Total:]]></text>
      </element>
      <element kind="textField" style="bold" x="605" y="167" width="140" height="15" blankWhenNull="true">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <expression><![CDATA[$F{accessExpenseTotal}]]></expression>
      </element>
      <element kind="staticText" style="bold" x="400" y="182" width="200" height="15">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <text><![CDATA[Total Expenses:]]></text>
      </element>
      <element kind="textField" style="bold" x="605" y="182" width="140" height="15" blankWhenNull="true">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <expression><![CDATA[$F{campAndAccessTotal}]]></expression>
      </element>
      <element kind="staticText" style="bold" x="5" y="202" width="120" height="15">
        <printWhenExpression><![CDATA[$P{p_do_print_comment}]]></printWhenExpression>
        <text><![CDATA[Comments:]]></text>
      </element>
      <element kind="textField" x="130" y="202" width="615" height="30" textAdjust="StretchHeight" blankWhenNull="true">
        <printWhenExpression><![CDATA[$P{p_do_print_comment}]]></printWhenExpression>
        <expression><![CDATA[$F{comments}]]></expression>
      </element>
      <element kind="line" x="5" y="235" width="740" height="1"/>
    </band>
  </detail>
  <pageFooter height="15">
    <element kind="staticText" x="700" y="0" width="32" height="15" vTextAlign="Bottom">
      <text><![CDATA[Page:]]></text>
    </element>
    <element kind="textField" x="734" y="0" width="22" height="15" hTextAlign="Center" vTextAlign="Bottom">
      <expression><![CDATA[$V{PAGE_NUMBER}]]></expression>
    </element>
    <element kind="staticText" x="756" y="0" width="21" height="15" hTextAlign="Center" vTextAlign="Bottom">
