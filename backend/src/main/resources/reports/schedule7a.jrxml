<?xml version="1.0" encoding="UTF-8"?>
<!--
  Schedule 7A (Bridge Costs) — JasperReports 7 template (AD-16, Epic 20.2). Bean-datasource fill
  from Schedule7aService's DTO (the 20.2 data-feed decision): one detail card per bridge, with the
  New/Used construction type resolved code->description by the service (from its codeLists) and the
  BR-06 totals it computes. Values arrive PRE-FORMATTED as Strings.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    name="schedule7a" pageWidth="842" pageHeight="595" orientation="Landscape"
    whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20"
    topMargin="30" bottomMargin="30">
  <style name="bold" bold="true"/>
  <parameter name="millTitleBlock" class="java.lang.String"/>
  <parameter name="year" class="java.lang.Integer"/>
  <parameter name="p_do_print_body" class="java.lang.Boolean"/>
  <parameter name="p_do_print_comment" class="java.lang.Boolean"/>
  <field name="locationName" class="java.lang.String"/>
  <field name="builtDate" class="java.lang.String"/>
  <field name="newUsed" class="java.lang.String"/>
  <field name="sitePlanCost" class="java.lang.String"/>
  <field name="totalMaterial" class="java.lang.String"/>
  <field name="totalDeliver" class="java.lang.String"/>
  <field name="totalInstall" class="java.lang.String"/>
  <field name="grandTotal" class="java.lang.String"/>
  <field name="comments" class="java.lang.String"/>
  <title height="30">
    <element kind="staticText" style="bold" x="0" y="0" width="802" height="15" hTextAlign="Center">
      <text><![CDATA[Government of British Columbia]]></text>
    </element>
    <element kind="textField" x="0" y="15" width="802" height="15" hTextAlign="Center">
      <expression><![CDATA[$P{year} + " Annual Interior Logging Cost Report"]]></expression>
    </element>
  </title>
  <pageHeader height="30">
    <element kind="staticText" x="0" y="0" width="600" height="15">
      <text><![CDATA[Schedule 7A:  Bridge Costs]]></text>
    </element>
    <element kind="textField" x="0" y="15" width="600" height="15" hTextAlign="Left" blankWhenNull="true">
      <expression><![CDATA[$P{millTitleBlock}]]></expression>
    </element>
    <element kind="staticText" x="600" y="0" width="202" height="15" hTextAlign="Right">
      <text><![CDATA[Timber Pricing Branch]]></text>
    </element>
    <element kind="textField" x="600" y="15" width="202" height="15" hTextAlign="Right" pattern="MMMMM dd, yyyy HH:mm:ss">
      <expression><![CDATA[new java.util.Date()]]></expression>
    </element>
  </pageHeader>
  <detail>
    <band height="130">
      <element kind="staticText" style="bold" x="5" y="5" width="150" height="15">
        <text><![CDATA[Name/Location of Bridge :]]></text>
      </element>
      <element kind="textField" x="160" y="5" width="250" height="15" blankWhenNull="true">
        <expression><![CDATA[$F{locationName}]]></expression>
      </element>
      <element kind="staticText" x="430" y="5" width="60" height="15">
        <text><![CDATA[Date :]]></text>
      </element>
      <element kind="textField" x="490" y="5" width="100" height="15" blankWhenNull="true">
        <expression><![CDATA[$F{builtDate}]]></expression>
      </element>
      <element kind="staticText" x="600" y="5" width="70" height="15">
        <text><![CDATA[New/Used]]></text>
      </element>
      <element kind="textField" x="670" y="5" width="120" height="15" blankWhenNull="true">
        <expression><![CDATA[$F{newUsed}]]></expression>
      </element>
      <element kind="staticText" x="5" y="30" width="200" height="15">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <text><![CDATA[Site Plan / Gen. Arr.  ($)]]></text>
      </element>
      <element kind="textField" x="210" y="30" width="140" height="15" hTextAlign="Right" blankWhenNull="true">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <expression><![CDATA[$F{sitePlanCost}]]></expression>
      </element>
      <element kind="staticText" x="5" y="47" width="200" height="15">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <text><![CDATA[Material ($) :]]></text>
      </element>
      <element kind="textField" x="210" y="47" width="140" height="15" hTextAlign="Right" blankWhenNull="true">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <expression><![CDATA[$F{totalMaterial}]]></expression>
      </element>
      <element kind="staticText" x="5" y="64" width="200" height="15">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <text><![CDATA[Deliver ($) :]]></text>
      </element>
      <element kind="textField" x="210" y="64" width="140" height="15" hTextAlign="Right" blankWhenNull="true">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <expression><![CDATA[$F{totalDeliver}]]></expression>
      </element>
      <element kind="staticText" x="5" y="81" width="200" height="15">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <text><![CDATA[Install ($) :]]></text>
      </element>
      <element kind="textField" x="210" y="81" width="140" height="15" hTextAlign="Right" blankWhenNull="true">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <expression><![CDATA[$F{totalInstall}]]></expression>
      </element>
      <element kind="staticText" style="bold" x="5" y="98" width="200" height="15">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <text><![CDATA[Total ($) :]]></text>
      </element>
      <element kind="textField" style="bold" x="210" y="98" width="140" height="15" hTextAlign="Right" blankWhenNull="true">
        <printWhenExpression><![CDATA[$P{p_do_print_body}]]></printWhenExpression>
        <expression><![CDATA[$F{grandTotal}]]></expression>
      </element>
      <element kind="staticText" style="bold" x="400" y="30" width="120" height="15">
        <printWhenExpression><![CDATA[$P{p_do_print_comment}]]></printWhenExpression>
        <text><![CDATA[Comments:]]></text>
      </element>
      <element kind="textField" x="400" y="47" width="390" height="60" textAdjust="StretchHeight" blankWhenNull="true">
        <printWhenExpression><![CDATA[$P{p_do_print_comment}]]></printWhenExpression>
        <expression><![CDATA[$F{comments}]]></expression>
      </element>
      <element kind="line" x="5" y="125" width="785" height="1"/>
    </band>
  </detail>
  <pageFooter height="15">
    <element kind="staticText" x="700" y="0" width="32" height="15" vTextAlign="Bottom">
      <text><![CDATA[Page:]]></text>
    </element>
    <element kind="textField" x="734" y="0" width="22" height="15" hTextAlign="Center" vTextAlign="Bottom">
      <expression><![CDATA[$V{PAGE_NUMBER}]]></expression>
    </element>
    <element kind="staticText" x="756" y="0" width="21" height="15" hTextAlign="Center" vTextAlign="Bottom">
      <text><![CDATA[of]]></text>
    </element>
    <element kind="textField" x="777" y="0" width="22" height="15" hTextAlign="Center" vTextAlign="Bottom" evaluationTime="Report">
      <expression><![CDATA[$V{PAGE_NUMBER}]]></expression>
    </element>
  </pageFooter>
</jasperReport>
